# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# You do not need all three. Every part — Role 1, Role 2, and the machine
# reading them — can be played by any provider, so one key runs the whole thing:
#
#   node --env-file=.env run.mjs --a openai --b openai --machine openai
#   node --env-file=.env run.mjs --a openai --b claude --machine gemini
#
# And --machine keyword needs no key for the reader at all.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-3.6-flash
# MACHINE_MODEL=claude-opus-5
