# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# You do not need both. Every part — Role 1, Role 2, and the machine reading
# them — can be played by either provider, so one key runs the whole thing:
#
#   node --env-file=.env run.mjs --a openai --b openai --machine openai
#   node --env-file=.env run.mjs --a claude --b claude --machine claude
#
# And --machine keyword needs no key for the reader at all.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# CLAUDE_MODEL=claude-opus-5
# OPENAI_MODEL=gpt-4o
# MACHINE_MODEL=claude-opus-5
